      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_aviation_data' name='federated.0j7ii6v0o6e8i714azfdn0im5o5f' />
          </datasources>
          <datasource-dependencies datasource='federated.0j7ii6v0o6e8i714azfdn0im5o5f'>
            <column caption='Aircraft damage' datatype='string' name='[Aircraft_damage]' role='dimension' type='nominal' />
            <column caption='Incident Count' datatype='integer' name='[Calculation_4352799444364292096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Event_Id])' />
            </column>
            <column caption='Percentage of Total Incidents' datatype='real' name='[Calculation_5556456813533278208]' role='measure' type='quantitative'>
